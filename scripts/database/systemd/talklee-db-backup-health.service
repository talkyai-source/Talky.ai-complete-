[Unit]
OnFailure=talky-notify@%n.service
Description=Verify actual flat local dump and encrypted off-host DB/media backup

[Service]
Type=oneshot
User=root
UMask=0077
EnvironmentFile=-/etc/talky/db-backup.env
ExecStart=/usr/bin/python3 /opt/talky/scripts/database/offhost.py health --backup-root /var/backups/talky --maximum-age-hours 26
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

# Nonzero status must be routed to the approved operator alert receiver.
