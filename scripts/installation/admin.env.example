VITE_API_BASE_URL=https://api.example.com/api/v1
VITE_USE_DUMMY_AUTH=false
VITE_ADMIN_DEV_MODE=false
# Optional public Cloudflare Turnstile site key. When set, the sign-in page shows the challenge
# and sends its token. Set it before the backend turns on AUTH_TURNSTILE_REQUIRED, and add this
# admin hostname to the backend TURNSTILE_ALLOWED_HOSTNAMES and to the widget's hostnames.
VITE_TURNSTILE_SITE_KEY=
# All VITE_ variables are public browser build inputs; do not add secrets.
