# Fresh-host runtime environment for install_talklee.sh.
# Copy outside the repository, replace every REPLACE_ value, and chmod 0600.
# This file covers the installer and production startup prerequisites plus the
# selected existing Deepgram/Groq/Cartesia/Asterisk path. backend/.env.example
# remains the catalog for optional integrations and operational tuning.
# Use literal KEY=value entries. Do not use shell substitutions or ${...}.

# Production process behavior and public application origins.
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=https://app.example.com
API_BASE_URL=https://api.example.com
CORS_ORIGINS=https://app.example.com,https://admin.example.com

# External PostgreSQL, prepared and migrated separately. URL-encode credentials.
# Runtime role: NOSUPERUSER NOBYPASSRLS NOCREATEDB NOCREATEROLE.
# The installer copies database_ca_file to the sslrootcert path below.
# Do not add MIGRATION_DATABASE_URL or READ_DATABASE_URL to this runtime file.
DATABASE_URL=postgresql://talky_runtime:REPLACE_WITH_URL_ENCODED_DATABASE_PASSWORD@db.example.net:5432/talkyai?sslmode=verify-full&sslrootcert=/etc/ssl/certs/talky-db-ca.pem
PG_POOL_ACQUIRE_TIMEOUT=10

# A separate Redis container is bound to this host's loopback interface.
# Use at least 32 URL-safe characters (letters, digits, underscore or hyphen).
REDIS_URL=redis://:REPLACE_WITH_32_OR_MORE_URL_SAFE_CHARACTERS@127.0.0.1:6379/0

# Authentication/signing keys. Restore existing keys when preserving sessions;
# generate new distinct random values only for a genuinely new environment.
JWT_SECRET=REPLACE_WITH_RETAINED_OR_NEW_32_PLUS_CHARACTER_JWT_SECRET
SECRET_KEY=REPLACE_WITH_RETAINED_OR_NEW_32_PLUS_CHARACTER_APP_SECRET
JWT_EXPIRY_HOURS=24
SESSION_COOKIE_SECURE=true

# Persistent encryption keys: retain the EXACT originals with restored data.
# Replacing these keys does not rotate old ciphertext; it makes it unreadable.
# SECRETS_MASTER_KEY wraps stored tenant/provider secrets; new deployments use
# a securely generated 64-character hex key. CONNECTOR_ENCRYPTION_KEY is Fernet.
SECRETS_MASTER_KEY=REPLACE_WITH_RETAINED_SECRETS_MASTER_KEY
CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_RETAINED_OR_NEW_FERNET_KEY
CONNECTOR_ENCRYPTION_KEYS_OLD=

# Protected metrics endpoint and two distinct gateway authentication domains.
# Internal and gateway tokens must each contain at least 32 characters.
TELEPHONY_METRICS_TOKEN=REPLACE_WITH_PRIVATE_METRICS_TOKEN
INTERNAL_SERVICE_TOKEN=REPLACE_WITH_32_PLUS_CHARACTER_CALLBACK_TOKEN
VOICE_GATEWAY_AUTH_TOKEN=REPLACE_WITH_DIFFERENT_32_PLUS_CHARACTER_GATEWAY_TOKEN
VOICE_GATEWAY_CALLBACK_HOST=127.0.0.1
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# Existing selected voice providers in backend/config/providers.yaml.
# These credentials enable speech recognition, language responses and speech.
# Restore any extra keys required by the existing saved tenant agent profiles.
DEEPGRAM_API_KEY=REPLACE_WITH_DEEPGRAM_API_KEY
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
CARTESIA_API_KEY=REPLACE_WITH_CARTESIA_API_KEY
TTS_PROVIDER=cartesia

# Current Asterisk-only topology; no FreeSWITCH/proxy credentials are implied.
TELEPHONY_PROVIDER=sip
TELEPHONY_ADAPTER=asterisk
ASTERISK_ARI_HOST=127.0.0.1
ASTERISK_ARI_PORT=8088
ASTERISK_ARI_USER=talky
# Must exactly match the reviewed ari.conf user, with 32+ URL-safe characters.
ASTERISK_ARI_PASSWORD=REPLACE_WITH_32_PLUS_CHARACTER_ARI_PASSWORD
ASTERISK_ARI_APP=talky_ai
ASTERISK_GATEWAY_BASE_URL=http://127.0.0.1:18080
ASTERISK_GATEWAY_RTP_IP=127.0.0.1
# Gateway-local media ports, distinct from carrier-facing rtp.conf/firewall ports.
ASTERISK_RTP_PORT_START=32000
ASTERISK_RTP_PORT_END=32999
TELEPHONY_PJSIP_CONF_DIR=/etc/asterisk/pjsip.d
TELEPHONY_PJSIP_AUTO_RELOAD=on
TELEPHONY_STATE_BACKEND=memory

# Production admission safeguards. Keep staging proof scope variables absent.
TELEPHONY_DEV_BYPASS_GUARD_ERRORS=false
TELEPHONY_LOCAL_DEV=false
CALLER_ID_ENFORCEMENT_MODE=enforce
TELEPHONY_INBOUND_REQUIRE_TENANT=true
INBOUND_STRICT_ROUTING=true
TELEPHONY_STRICT_INBOUND_ROUTING=true
INBOUND_TRANSFER_STAGING_PROOF_ENABLED=false

# Billing remains owned by the Stripe workstream. Supply the real live account
# key and matching webhook endpoint signing secret; test keys fail prod_gate.
# STRIPE_BILLING_DISABLED=1 is an explicit non-billing environment decision and
# cannot be counted as completion of the subscription deliverable.
STRIPE_BILLING_DISABLED=0
STRIPE_SECRET_KEY=REPLACE_WITH_LIVE_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_STRIPE_WEBHOOK_SIGNING_SECRET

# Local file paths created and owned by the talky service account. They need
# separate backup/restore and retention acceptance; PostgreSQL backup excludes
# these files. Restore existing media before claiming customer recovery.
LOCAL_RECORDINGS_DIR=/opt/talky/backend/recordings
RECORDINGS_STORAGE_DIR=/opt/talky/backend/audio_files/storage
LOCAL_FEEDBACK_DIR=/opt/talky/backend/feedback_audio
CLEANUP_DRY_RUN=true
# Keep false until durable local feedback storage is approved; alternatively
# add the existing S3-compatible storage settings from backend/.env.example.
CALL_FEEDBACK_ALLOW_LOCAL_STORAGE=false

# Existing SMTP delivery for verification/recovery and application email.
# Keep EMAIL_* and SMTP_* credentials consistent; no interpolation is performed.
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USER=REPLACE_WITH_APPROVED_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_APPROVED_SMTP_PASSWORD
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Talklee
EMAIL_USER=REPLACE_WITH_APPROVED_SMTP_USERNAME
EMAIL_PASS=REPLACE_WITH_APPROVED_SMTP_PASSWORD

# Existing Google OAuth and any tenant-selected optional providers need their
# original approved configuration. Use backend/.env.example for those inputs;
# leave unused integrations unset rather than adding fake credential values.
