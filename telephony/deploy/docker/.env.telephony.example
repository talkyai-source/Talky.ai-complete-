# WS-A staging defaults.
# Best practice: pin immutable image digests before production use.

# OpenSIPS runtime with TLS modules baked in for WS-B baseline.
OPENSIPS_IMAGE=talky/opensips:3.4-tls
# rtpengine is built locally from Dockerfile by default.
RTPENGINE_IMAGE=talky/rtpengine:ubuntu24.04
# Public bootstrap image. Replace with your pinned enterprise image in production.
FREESWITCH_IMAGE=safarov/freeswitch:latest
ASTERISK_IMAGE=talky/asterisk:bookworm

OPENSIPS_SIP_IP=0.0.0.0
OPENSIPS_SIP_PORT=15060
OPENSIPS_TLS_PORT=15061
OPENSIPS_TLS_ONLY=0

OPENSIPS_CANARY_ENABLED=0
OPENSIPS_CANARY_PERCENT=0
OPENSIPS_CANARY_FREEZE=1
# Required before enabling the dedicated inbound canary. Use the normalized
# Request-URI user delivered by the carrier (digits only, no '+' prefix).
OPENSIPS_CANARY_DID=__UNCONFIGURED_DID__
# Frozen DID assignment. Startup rejects enabled ingress without a UUID.
OPENSIPS_CANARY_AGENT_ID=__UNCONFIGURED_AGENT__
# Anchored allowlist for the local Asterisk leg plus carrier/SBC source IP(s).
# Keep the single quotes so shell-based runbooks preserve the regex escaping.
# Example: '^(127\.0\.0\.1|203\.0\.113\.10)$'
OPENSIPS_CANARY_SOURCE_REGEX='^127\.0\.0\.1$'
FREESWITCH_SIP_PORT=5080
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=replace_with_secret
ASTERISK_SIP_PORT=5070
ASTERISK_ARI_HOST=127.0.0.1
ASTERISK_ARI_PORT=8088
ASTERISK_ARI_USERNAME=day5
ASTERISK_ARI_PASSWORD=replace_with_secret
ASTERISK_ARI_APP=talky_day5
ASTERISK_HANGUP_CONFIRM_TIMEOUT_S=5.0
ASTERISK_HANGUP_CONFIRM_POLL_S=0.1
DAY5_TEST_EXTENSION=750

RTPENGINE_NG_PORT=2223
RTP_PORT_MIN=40000
RTP_PORT_MAX=44999
