{
  "scope": "Actual EmailService SQL against a private LIKE table and restricted PG role.\n\nOnly loopback PostgreSQL is contacted. Connector selection, current-account\nadmission, encryption and provider send are synthetic. This does not test the\nnew reviewed-account selector SQL, provider delivery, or the full FK graph.\n",
  "cases": [
    {
      "case": "acknowledged pending-to-running claim merges proof and preserves unrelated input",
      "passed": true,
      "acknowledgement": "UPDATE 1"
    },
    {
      "case": "SQL NULL input becomes an object with original authorization",
      "passed": true
    },
    {
      "case": "foreign tenant bind acknowledges UPDATE 0 and cannot read or change owned rows; scope does not leak",
      "passed": true
    },
    {
      "case": "running intent is not rebound",
      "passed": true,
      "acknowledgement": "UPDATE 0"
    },
    {
      "case": "cancelled intent is not rebound",
      "passed": true,
      "acknowledgement": "UPDATE 0"
    },
    {
      "case": "completed intent is not rebound",
      "passed": true,
      "acknowledgement": "UPDATE 0"
    },
    {
      "case": "unknown intent is not rebound",
      "passed": true,
      "acknowledgement": "UPDATE 0"
    },
    {
      "case": "missing intent rejects acknowledged UPDATE 0",
      "passed": true
    },
    {
      "case": "bind acknowledgement fault rolls back real UPDATE and releases connection for retry",
      "passed": true
    },
    {
      "case": "actual service refuses send after rolled-back bind acknowledgement",
      "passed": true,
      "synthetic_send_attempts": 0
    },
    {
      "case": "preclaimed_cancelled rejects send and failure cleanup preserves the other phase/row",
      "passed": true,
      "synthetic_send_attempts": 0,
      "acknowledgement": "UPDATE 0"
    },
    {
      "case": "preclaimed_running rejects send and failure cleanup preserves the other phase/row",
      "passed": true,
      "synthetic_send_attempts": 0,
      "acknowledgement": "UPDATE 0"
    },
    {
      "case": "actual service commits original authorization before one synthetic accepted send and saves receipt",
      "passed": true,
      "synthetic_send_attempts": 1,
      "separate_connection_observed_pre_send_commit": true,
      "receipt_is_synthetic": true,
      "recipient_delivery_proven": false
    },
    {
      "case": "completed_receipt_fails retains original durable intent; no second send in this invocation",
      "passed": true,
      "synthetic_send_attempts": 1,
      "durable_status": "unknown",
      "actual_pg_fault": "division_by_zero",
      "receipt_is_synthetic": true
    },
    {
      "case": "all_receipts_fail retains original durable intent; no second send in this invocation",
      "passed": true,
      "synthetic_send_attempts": 1,
      "durable_status": "running",
      "actual_pg_fault": "division_by_zero",
      "receipt_is_synthetic": true
    }
  ],
