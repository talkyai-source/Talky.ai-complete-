# Install as /etc/talky/inbound-synthetic.env with root ownership and mode 0640.
# Use a carrier-provisioned DID assigned to an always-open, agent-first
# synthetic campaign; a business-hours DID would correctly reject overnight
# and create a false media alarm. The call exits the host through the carrier
# and returns on the real inbound route.
INBOUND_SYNTHETIC_DID=+15551234567
INBOUND_SYNTHETIC_TRUNK_ENDPOINT=carrier-endpoint
INBOUND_SYNTHETIC_WAIT_SECONDS=20
