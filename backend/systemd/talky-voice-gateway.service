# Talky.ai C++ Voice Media Gateway
#
# Recovered into version control 2026-07-24, then hardened for atomic,
# commit-matched gateway releases. deploy_to_server.sh builds and tests the
# selected SHA outside the checkout, proves traffic is frozen and drained,
# atomically publishes /opt/talky/runtime/bin/voice_gateway, installs this unit,
# and restarts it before the matching backend.
#
#   * Type=exec / Restart=on-failure with no watchdog, where the three
#     workers use Type=notify / Restart=always / WatchdogSec=180. The
#     gateway has no sd_notify support, so Type=notify would fail to start.
#   * User=admins — the gateway is the only service that does NOT run as
#     root. That is the correct posture; the others are the anomaly (F-10).
#   * No StartLimitIntervalSec / StartLimitBurst, where the workers set
#     300 / 5. This unit falls back to systemd's default crash-loop guard
#     (5 starts in 10s). Accurate to production, not an omission here.
#
# The EnvironmentFile supplies mandatory, distinct INTERNAL_SERVICE_TOKEN and
# VOICE_GATEWAY_AUTH_TOKEN values plus the exact VOICE_GATEWAY_CALLBACK_HOST
# and BACKEND_INTERNAL_URL origin. The binary refuses startup if the secrets
# are invalid/reused or any callback host, scheme, or port is not exactly pinned.
# Do not restart this unit outside the documented freeze + zero-call procedure.

[Unit]
Description=Talky.ai Voice Media Gateway (C++)
After=network.target

[Service]
User=admins
Group=admins
Type=exec
WorkingDirectory=/opt/talky/services/voice-gateway-cpp
EnvironmentFile=/opt/talky/backend/.env
ExecStart=/opt/talky/runtime/bin/voice_gateway --host 127.0.0.1 --port 18080
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=talky-voice-gateway

[Install]
WantedBy=multi-user.target
