# ============================================================================
# Talky.ai — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values
# NEVER commit the .env file to git

# ============================================================================
# Email Service Configuration (Microsoft 365 / GoDaddy)
# ============================================================================

# Sender email address
# For talkleeai.com: noreply@talkleeai.com
EMAIL_USER=noreply@talkleeai.com

# Microsoft 365 password or App Password
# If MFA is enabled on the account, use an App Password from:
# https://account.microsoft.com/security > App passwords
# Format: "xxxx xxxx xxxx xxxx" (16 characters, spaces can be removed)
EMAIL_PASS=your_app_password_or_m365_password

# ============================================================================
# AI Provider API Keys
# ============================================================================

# STT Providers
DEEPGRAM_API_KEY=your_deepgram_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Short reviewer voice notes (POST /calls/{id}/feedback).
# Production requires configured S3-compatible storage; local-disk fallback is
# development-only so an acknowledged note survives container replacement.
S3_BUCKET_NAME=talky-recordings
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Set for Cloudflare R2 / MinIO; omit for AWS S3.
S3_ENDPOINT_URL=
# Fail-closed permanent erasure bounds. The storage identity also needs
# GetBucketVersioning, ListBucketVersions, DeleteObjectVersion, DeleteObject,
# and HeadObject for recording/feedback deletion to complete.
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=10
S3_PERMANENT_DELETE_TIMEOUT_SECONDS=45
S3_PERMANENT_DELETE_MAX_PAGES=10
S3_PERMANENT_DELETE_MAX_VERSIONS=5000
CALL_FEEDBACK_MAX_AUDIO_BYTES=10485760
CALL_FEEDBACK_TRANSCRIPTION_TIMEOUT_SECONDS=10
CALL_FEEDBACK_PENDING_RETRY_AFTER_SECONDS=30
CALL_FEEDBACK_DEEPGRAM_MODEL=nova-3
CALL_FEEDBACK_DEEPGRAM_LANGUAGE=en
LOCAL_FEEDBACK_DIR=./feedback_audio
# Allow the local-disk fallback to serve production. Leave false on any host
# whose disk does not survive a rollout (containers without a mounted volume).
# Set true only where local storage is genuinely durable — e.g. the systemd
# deployment on Hetzner, whose /opt/talky/backend/recordings has carried call
# audio across every release. Ignored entirely when S3 is configured.
CALL_FEEDBACK_ALLOW_LOCAL_STORAGE=false

# LLM Providers
GROQ_API_KEY=your_groq_api_key_here
# Cerebras Inference (optional). When set, Cerebras models appear in the
# AI-Options LLM menu and in the dashboard assistant's model picker.
CEREBRAS_API_KEY=your_cerebras_api_key_here
# Google Gemini (Gemini 2.5 Flash; will also serve Gemma 4 once available via
# AI Studio). Leave unset to hide the Gemini option from the AI Options UI.
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================================================
# Application URLs
# ============================================================================

# Frontend URL for verification email links
# Used to construct verification URLs in emails
FRONTEND_URL=https://talkleeai.com

# Backend API base URL
# Used to construct verification link in email
API_BASE_URL=https://api.talkleeai.com

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL database connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://talkyai:REPLACE_WITH_STRONG_DB_PASSWORD@localhost:5432/talkyai

# Seconds to wait for a free connection from the asyncpg pool before giving up
# with DatabasePoolTimeoutError. Without a bound, an exhausted pool (leaked
# connections or a wedged DB) hangs every caller forever instead of failing
# fast. Default 10; raise only if you have genuinely slow interactive queries.
PG_POOL_ACQUIRE_TIMEOUT=10

# ============================================================================
# Authentication & Security
# ============================================================================

# JWT secret for signing tokens
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_long_random_secret_key_here_at_least_32_chars

# Alternative secret key (legacy)
SECRET_KEY=your_alternative_secret_key_here

# Master encryption key for sensitive data
MASTER_KEY=your_master_encryption_key_here

# ----------------------------------------------------------------------------
# SECRETS_MASTER_KEY — the key-encryption key (KEK) for the secrets store.
# ----------------------------------------------------------------------------
# Wraps the per-secret DEKs behind SecretsManager and app/core/kms.py: tenant
# credentials, provider API keys, connector tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# READ THIS BEFORE CHANGING IT. Only the ciphertext lives in the database; the
# key lives here. So:
#   - CHANGE it  -> every secret already stored becomes permanently unreadable.
#   - UNSET it   -> in dev, a random ephemeral key is minted per process (fine,
#                   nothing durable to lose). In production the service now
#                   REFUSES TO BOOT rather than silently re-key your data.
#   - ROTATE it  -> only with a tested re-encryption job that decrypts under the
#                   old key and re-encrypts under the new one. There is no
#                   recovery path if you skip that step.
# Required in production (enforced by app/core/prod_gate.py). Keep it identical
# across every process/pod of a deployment, and back it up somewhere that is not
# the same machine.
SECRETS_MASTER_KEY=REPLACE_WITH_64_CHAR_HEX_KEY

# Connector OAuth tokens must use a stable Fernet key on every backend pod.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CONNECTOR_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# During key rotation, put prior Fernet keys here as a comma-separated list.
# Keep them until every stored connector token has been re-encrypted with the
# current key. Leave empty when there are no prior keys.
CONNECTOR_ENCRYPTION_KEYS_OLD=

# Shared Google OAuth application used by Gmail, Calendar, and Drive.
# Configure the matching callback URI in Google Cloud Console.
GOOGLE_CLIENT_ID=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# Session lifetime in hours
SESSION_LIFETIME_HOURS=24

# ============================================================================
# Environment Settings
# ============================================================================

# Environment: development, staging, production
ENVIRONMENT=production

# Proof-only gate for controlled linked-leg inbound transfer validation.
# This is honored only when ENVIRONMENT=staging. Production startup refuses
# the switch and either scope value. All three values must identify one signed
# staging tenant/config test fixture before the runtime can open.
INBOUND_TRANSFER_STAGING_PROOF_ENABLED=false
INBOUND_TRANSFER_STAGING_PROOF_TENANT_ID=
INBOUND_TRANSFER_STAGING_PROOF_CONFIG_ID=

# Debug mode (false in production)
DEBUG=false

# ============================================================================
# Optional: Logging & Monitoring
# ============================================================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Shared token required in the X-Metrics-Token header to read the telephony
# /metrics endpoint. If left EMPTY the endpoint is served to anyone who can
# reach it — so it is mandatory in production (enforced by prod_gate.py) and
# optional locally. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEPHONY_METRICS_TOKEN=

# Fail-closed canary evidence identity. Freeze and deploy the signed candidate
# before generating a new UUIDv4 run ID and UTC gate-start timestamp. The
# collector queries only distinct records created at/after that start for the
# exact tenant + pinned inbound config + dedicated DID. DID is 7-15 digits
# without '+', matching OPENSIPS_CANARY_DID. Candidate digest is an immutable
# artifact/bundle sha256 recorded by the signed manifest, not a mutable tag or
# branch. Runs older than
# six hours, future starts, missing values, and malformed values publish zero
# evidence and make the SLO scrape unsuccessful.
TELEPHONY_CANARY_TENANT_ID=
TELEPHONY_CANARY_CONFIG_ID=
TELEPHONY_CANARY_DID=
TELEPHONY_CANARY_CANDIDATE_DIGEST=
TELEPHONY_CANARY_RUN_ID=
TELEPHONY_CANARY_GATE_STARTED_AT=

# ============================================================================
# Optional: Rate Limiting & Security
# ============================================================================

# Redis URL for rate limiting and caching
REDIS_URL=redis://localhost:6379

# ============================================================================
# Voice Pipeline (RTP)
# ============================================================================
# RTP_CODEC controls the legacy raw-RTP path (not used on FreeSWITCH or the
# Asterisk + C++ Voice Gateway path). The C++ gateway negotiates its own
# codec and stays at PCMU 8kHz on the wire; we upsample to 16kHz internally
# for Deepgram Flux. Leave this as ulaw unless you know you need otherwise.
RTP_REMOTE_IP=127.0.0.1
RTP_REMOTE_PORT=5004
RTP_LOCAL_PORT=5005
RTP_CODEC=ulaw
# TTS_SOURCE_SAMPLE_RATE: rate the TTS provider should synthesize at.
# 16000 Hz matches the new telephony internal rate (Flux native) and avoids
# a redundant downsample step. Use 24000 only for browser-only deployments
# where you want extra TTS richness on headphones.
TTS_SOURCE_SAMPLE_RATE=16000

# FreeSWITCH ESL
FREESWITCH_ESL_HOST=127.0.0.1
FREESWITCH_ESL_PORT=8021
FREESWITCH_ESL_PASSWORD=ClueCon

# Asterisk confirmed-hangup proof. DELETE acceptance is followed by channel
# inventory polling; keep the total at or below the five-second teardown SLO.
ASTERISK_HANGUP_CONFIRM_TIMEOUT_S=5.0
ASTERISK_HANGUP_CONFIRM_POLL_S=0.1

# Tenant-managed PJSIP trunks. Production Asterisk mode refuses to commit an
# activation/edit unless the config file is written and a live reload is
# executed (or coalesced into one already pending).
TELEPHONY_PJSIP_AUTO_RELOAD=on
TELEPHONY_PJSIP_CONF_DIR=/etc/asterisk/pjsip.d
# talky-trunk-status runs every ~15s; admission rejects evidence older than 60s.
TELEPHONY_TRUNK_STATUS_FRESHNESS_SECONDS=60
# Keep off for hosted tenants. Enabling private SIP targets is a platform-wide
# network-security decision and must be paired with egress/firewall controls.
TELEPHONY_ALLOW_PRIVATE_SIP_TARGETS=off

# ============================================================================
# Internal service-to-service auth (architecture roadmap item 3)
# ----------------------------------------------------------------------------
# Shared secret the dialer worker sends as X-Internal-Service-Token when it
# calls the API process to originate a call (POST /sip/telephony/call). The
# CSRF middleware exempts requests carrying a valid token, so the dialer no
# longer has to spoof a browser Origin header. MUST be identical in the
# talky-api and talky-dialer-worker environments. Generate with e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, the originate and gateway-audio callbacks are rejected (fail-safe).
# This secret is mandatory in production and must also be loaded by the C++
# gateway's systemd unit.
INTERNAL_SERVICE_TOKEN=
# Separate bearer secret for the loopback C++ gateway control plane. Both
# gateway secrets must be 32-512 characters; startup rejects an unset/short
# value or reuse of INTERNAL_SERVICE_TOKEN.
VOICE_GATEWAY_AUTH_TOKEN=
# Exact numeric loopback IPv4 host permitted to receive authenticated caller-audio
# callbacks. It must equal the host in BACKEND_INTERNAL_URL; empty means reject.
VOICE_GATEWAY_CALLBACK_HOST=127.0.0.1
# Exact plain-http loopback origin with an explicit canonical port and no
# credentials, query, fragment, trailing slash, or base path. The C++ sender accepts
# only /api/v1/sip/telephony/audio/<safe-session-id> at this exact origin.
BACKEND_INTERNAL_URL=http://127.0.0.1:8000
# Require the gateway to echo protocol v2, codec, session id, and the exact
# canonical config digest before a call can own media. Production defaults true;
# keep it explicit so configuration review can see the atomic-version contract.
VOICE_GATEWAY_REQUIRE_CONFIG_ACK=true
# Dedicated dead-media inventory cadence. Two explicit misses are required, so
# 1.0 ends a channel whose gateway RTP session vanished in roughly two seconds.
TELEPHONY_MEDIA_WATCHDOG_INTERVAL_S=1.0

# ============================================================================
# Telephony per-call state backend (architecture roadmap item 1, Phase 1)
# ----------------------------------------------------------------------------
# memory (default) — per-call state lives only in this process. A restart
#   drops every in-flight call. Identical to historical behaviour.
# redis           — mirrors a call-ownership ledger to Redis so a process
#   restart recovers in-flight calls: the successor hangs them up and records
#   the terminal state instead of leaving zombies. Requires REDIS_URL.
#
# Roll out by deploying with =memory (no change), then flipping to =redis.
# Kill-switch rollback is just: set =memory and restart talky-api — no deploy.
TELEPHONY_STATE_BACKEND=memory
# POD_ID — optional human-readable prefix for this process's heartbeat key
# (telephony:pod:{POD_ID}:{short-uuid}:heartbeat). Defaults to the hostname.
# Identity is always made unique per process; this only affects readability.
# POD_ID=

# Workers
TTS_PROVIDER=google
MEDIA_GATEWAY_TYPE=rtp
WORKER_LOG_LEVEL=INFO
MAX_CONCURRENT_PIPELINES=50

# --- C++ voice gateway: VG-01 sequence-ordered STT tap ---
# Default ON (fixes garbled spoken emails/phone digits under UDP jitter; adds
# ~60-80ms STT latency). Instant revert without redeploy: set false + restart.
# VOICE_GATEWAY_STT_REORDER=true
# VOICE_GATEWAY_STT_REORDER_WINDOW=3
# VOICE_GATEWAY_STT_REORDER_HOLD_MS=80

# Wrap-up nudge before the per-call max-duration hangup (both directions).
# Seconds before the effective deadline at which ONE system instruction is
# injected telling the agent to finish and say goodbye. Clamped to 5-60.
# CALL_WRAP_UP_LEAD_SECONDS=20
